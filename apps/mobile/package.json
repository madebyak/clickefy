{
  "name": "@clickfy/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "gen:router-types": "node scripts/gen-router-types.mjs",
    "pretypecheck": "node scripts/gen-router-types.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "preflight": "pnpm typecheck && pnpm lint",
    "build:android:preview": "pnpm preflight && EXPO_TOKEN=$(sed -n 's/^# export EXPO_TOKEN=//p' .env) eas build --profile preview --platform android",
    "clean": "rm -rf .expo node_modules .turbo ios android",
    "build:ios:preview": "pnpm preflight && EXPO_TOKEN=$(sed -n 's/^# export EXPO_TOKEN=//p' .env) eas build --profile preview --platform ios",
    "build:ios:prod": "pnpm preflight && EXPO_TOKEN=$(sed -n 's/^# export EXPO_TOKEN=//p' .env) eas build --profile production --platform ios --non-interactive",
    "submit:ios": "EXPO_TOKEN=$(sed -n 's/^# export EXPO_TOKEN=//p' .env) eas submit --platform ios --latest"
  },
  "dependencies": {
    "@clerk/expo": "^3.2.10",
    "@clickfy/sdk": "workspace:*",
    "@clickfy/types": "workspace:*",
    "@clickfy/ui": "workspace:*",
    "@expo-google-fonts/geist": "^0.4.1",
    "@expo-google-fonts/geist-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "^2.0.2",
    "@tanstack/query-async-storage-persister": "5.100.9",
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-query-persist-client": "5.100.9",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-checkbox": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "^57.0.23",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.3.1",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.4.1",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@clickfy/tsconfig": "workspace:*",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.18",
    "eas-cli": "^18.12.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
