# Clickefy Web — environment variables

# Base URL of the Clickefy Worker API.
#   local dev : http://localhost:8787  (wrangler dev in apps/api)
#   production: https://api.clickefy.ai
NEXT_PUBLIC_API_URL=https://api.clickefy.ai

# Auth (Clerk). Dev = the shared dev instance (same as apps/admin);
# production = clerk.clickefy.ai live keys (Vercel env only).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Billing (Stripe).
# ONLY the publishable key belongs here — it is compiled into the browser
# bundle and can do nothing but start a checkout. The SECRET key lives on
# the API Worker (apps/api/.dev.vars locally, `wrangler secret put` in
# production) and must never be added to Vercel or prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
