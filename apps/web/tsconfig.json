{
  "extends": "@clickfy/tsconfig/nextjs.json",
  "compilerOptions": {
    "target": "ES2022",
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", ".next", ".turbo"]
}
